TAGS "Dub Misc Endpoints"

NODE endpoint
SQL >

%
    SELECT
        timestamp,
        amount,
        country,
        city,
        latitude,
        longitude
    FROM dub_sale_events_mv
    WHERE
        timestamp > now() - INTERVAL 12 HOUR
        AND country != 'Unknown'
        AND city != 'Unknown'
        AND city != 'Ashburn'
    ORDER BY timestamp DESC
    LIMIT 500

TYPE ENDPOINT
