enum JobStatus {
  pending
  published
  failed
}

model Job {
  id          String    @id
  name        String
  payload     Json
  options     Json? // dispatch options replayed verbatim: deduplicationId, retries, queue, flowControl, label
  scheduledAt DateTime @default(now()) // when we should publish the job
  status      JobStatus @default(pending)
  attempts    Int       @default(0)
  lastError   String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, scheduledAt, attempts]) // retry cron: due pending/failed jobs
  @@index([status, createdAt]) // daily cleanup by status + age
}
