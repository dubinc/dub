enum EventType {
  click
  lead
  sale
  referral
  custom
}

enum RewardStructure {
  percentage
  flat
}

enum RewardSpendLimitInterval {
  allTime
  day
  week
  month
}

model Reward {
  id                 String                    @id
  programId          String?
  groupId            String?
  description        String?
  tooltipDescription String?                   @db.Text
  event              EventType
  type               RewardStructure           @default(percentage)
  amountInCents      Int?
  amountInPercentage Decimal?                  @db.Decimal(5, 2)
  maxDuration        Int? // in months (0 -> not recurring, null -> infinite)
  modifiers          Json?                     @db.Json
  config             Json?                     @db.Json
  spendLimitAmount   Int?
  spendLimitInterval RewardSpendLimitInterval?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  program              Program?            @relation(fields: [programId], references: [id])
  clickEnrollments     ProgramEnrollment[] @relation("ClickRewardEnrollments")
  leadEnrollments      ProgramEnrollment[] @relation("LeadRewardEnrollments")
  saleEnrollments      ProgramEnrollment[] @relation("SaleRewardEnrollments")
  referralEnrollments  ProgramEnrollment[] @relation("ReferralRewardEnrollments")
  customEnrollments    ProgramEnrollment[] @relation("CustomRewardEnrollments")
  clickPartnerGroup    PartnerGroup?       @relation("ClickReward")
  leadPartnerGroup     PartnerGroup?       @relation("LeadReward")
  salePartnerGroup     PartnerGroup?       @relation("SaleReward")
  referralPartnerGroup PartnerGroup?       @relation("ReferralReward")
  customPartnerGroup   PartnerGroup?       @relation("CustomReward")
  commissions          Commission[]
  clickLinkRewards     LinkReward[]        @relation("ClickLinkRewards")
  leadLinkRewards      LinkReward[]        @relation("LeadLinkRewards")
  saleLinkRewards      LinkReward[]        @relation("SaleLinkRewards")

  @@index([programId, event])
  @@index(event) // used in aggregate-clicks cron job
  @@index(groupId)
}

model LinkReward {
  id            String   @id @default(cuid())
  linkId        String   @unique
  clickRewardId String?
  leadRewardId  String?
  saleRewardId  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  link        Link    @relation(fields: [linkId], references: [id], onDelete: Cascade)
  clickReward Reward? @relation("ClickLinkRewards", fields: [clickRewardId], references: [id], onDelete: SetNull)
  leadReward  Reward? @relation("LeadLinkRewards", fields: [leadRewardId], references: [id], onDelete: SetNull)
  saleReward  Reward? @relation("SaleLinkRewards", fields: [saleRewardId], references: [id], onDelete: SetNull)

  @@index(clickRewardId)
  @@index(leadRewardId)
  @@index(saleRewardId)
}
